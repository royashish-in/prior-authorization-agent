# Prior Authorization Agent Environment Configuration
# Copy this file to .env and update values for your environment

# Application Settings
PA_ENVIRONMENT=development
PA_DEBUG=true
PA_HOST=127.0.0.1
PA_PORT=8000

# Security Settings (CHANGE IN PRODUCTION!)
PA_SECRET_KEY=your-secret-key-here-change-in-production
PA_ENCRYPTION_KEY=your-32-character-encryption-key-here
PA_ALLOWED_HOSTS=["localhost", "127.0.0.1"]
PA_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# PHI Encryption Master Key (Required for database encryption)
PHI_MASTER_KEY=your-phi-master-key-change-in-production

# Database Settings
PA_DATABASE_URL=sqlite:///./prior_auth.db
PA_DATABASE_ECHO=false

# Logging Settings
PA_LOG_LEVEL=INFO
PA_LOG_FORMAT=json

# JWT Settings
PA_JWT_ALGORITHM=HS256
PA_JWT_EXPIRATION_HOURS=24

# Rate Limiting
PA_RATE_LIMIT_REQUESTS=100
PA_RATE_LIMIT_WINDOW=60

# External Services
PA_CMS_API_URL=https://api.cms.gov
PA_CMS_API_TIMEOUT=30

# Performance Settings
PA_MAX_CONCURRENT_REQUESTS=1000
PA_REQUEST_TIMEOUT=120