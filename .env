# Prior Authorization Agent Environment Configuration
# Development environment settings

# Application Settings
PA_ENVIRONMENT=development
PA_DEBUG=true
PA_HOST=127.0.0.1
PA_PORT=8000

# Security Settings
PA_SECRET_KEY=dev-secret-key-change-in-production-12345678901234567890
PA_ENCRYPTION_KEY=dev-encryption-key-32-chars-long
PA_ALLOWED_HOSTS=["localhost", "127.0.0.1", "testserver"]
PA_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://127.0.0.1:8080", "null"]

# PHI Encryption Master Key (Required for database encryption)
PHI_MASTER_KEY=development-phi-master-key-for-testing-purposes-2024

# Database Settings
PA_DATABASE_URL=sqlite:///./prior_auth.db
PA_DATABASE_ECHO=false

# Logging Settings
PA_LOG_LEVEL=INFO
PA_LOG_FORMAT=json

# JWT Settings
PA_JWT_ALGORITHM=HS256
PA_JWT_EXPIRATION_HOURS=24

# Rate Limiting
PA_RATE_LIMIT_REQUESTS=100
PA_RATE_LIMIT_WINDOW=60

# External Services
PA_CMS_API_URL=https://api.cms.gov
PA_CMS_API_TIMEOUT=30

# Performance Settings
PA_MAX_CONCURRENT_REQUESTS=1000
PA_REQUEST_TIMEOUT=120

# LLM Integration Settings
HUGGINGFACE_API_TOKEN=your-huggingface-api-token-here
PA_HUGGINGFACE_API_URL=https://api-inference.huggingface.co/models
PA_LOCAL_MODELS_PATH=./models
PA_LLM_MAX_CONCURRENT_REQUESTS=10
PA_LLM_DEFAULT_TIMEOUT=30
PA_LLM_ENABLE_CACHE=true
PA_LLM_CACHE_TTL=3600
PA_LLM_HEALTH_CHECK_INTERVAL=300
PA_LLM_ENABLE_FALLBACK=true
PA_LLM_FALLBACK_TO_RULES=true

# Kiro Integration
KIRO_CODE=your-kiro-code-here
KIRO_PROJECT_ID=prior-authorization-agent
KIRO_ENVIRONMENT=development